# 🌊 Coastal Guardian Environment Variables Template

# --- BACKEND SETTINGS ---
# Environment: 'development' or 'production'
NODE_ENV=development

# Port for the Node.js Express server to listen on
PORT=3001

# PostgreSQL/Neon Database Connection URL (used by Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/coastal-threat-db?schema=public

# Secret key used for signing JSON Web Tokens (JWT)
JWT_SECRET=super_secret_jwt_sign_key_change_me_in_production

# Cors origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenWeather API Key (optional, used for live weather alerts and forecasts)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini API Key (used for RAG and AI chatbot functionality)
GEMINI_API_KEY=your_gemini_api_key_here

# --- PYTHON AI MODEL SERVICE (OPTIONAL) ---
# URL for the Python AI FastAPI backend service
AI_API_URL=http://localhost:8000

# OpenAI API Key (optional, if using python openai services)
OPENAI_API_KEY=your_openai_api_key_here

OpenWeather API key: 